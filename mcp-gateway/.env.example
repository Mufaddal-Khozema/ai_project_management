# ── Universal MCP Gateway Environment Configuration ──────────────────────
PORT=8005
HOST=0.0.0.0
ENVIRONMENT=development

# ── Root Backend Identity Resolution & Authorization ─────────────────────
BACKEND_URL=http://localhost:8000
SERVICE_API_KEY=svc_6Q22890ts96ox-oc0pavSc_OSWQZyueE8-J8AY5ytlo
INTEGRATION_TOKEN_ENCRYPTION_KEY=your_fernet_key_here=

# ── Voice Scrum Master Service ───────────────────────────────────────────
VOICE_SERVICE_URL=http://localhost:3001

# ── Kafka & Aiven Cloud Event Streaming ──────────────────────────────────
# For Local Kafka:
# KAFKA_BROKERS=localhost:9092
# KAFKA_SSL=false

# For Aiven Kafka (Option A: SASL_SSL with Username/Password):
# KAFKA_BROKERS=kafka-xxx-project.aivencloud.com:12345
# KAFKA_SSL=true
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=your_aiven_password
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# For Aiven Kafka (Option B: Client Certificate SSL):
# KAFKA_BROKERS=kafka-xxx-project.aivencloud.com:12345
# KAFKA_SSL=true
# KAFKA_SSL_CAFILE=./certs/ca.pem
# KAFKA_SSL_CERTFILE=./certs/service.cert
# KAFKA_SSL_KEYFILE=./certs/service.key

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=mcp-gateway
KAFKA_ENABLED=true
TOPIC_TASK_EVENTS=agent-bridge.task-events
TOPIC_MISSING_TOOLS=agent-bridge.missing-tool-requests


# ── Default Fallback Settings ────────────────────────────────────────────
FUZZY_MATCH_CUTOFF=0.35
DLP_SCRUB_KEYS=token,secret,password,key,authorization,bearer

# ── Agent Bridge Environment Example ───────────────────────────────────────────
APP_TITLE=Agent Bridge API
APP_VERSION=0.1.0
CONFIG_PATH=data/config.json
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Platforms ─────────────────────────────────────────────────────────────────
COMM_PLATFORM=discord
PM_PLATFORM=taiga

# ── Discord Bot ───────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_TRIGGER_ROLE=CoordinaAI

# ── Taiga Project Management ──────────────────────────────────────────────────
TAIGA_URL=https://api.taiga.io/api/v1
TAIGA_USER=your_taiga_username_or_email
TAIGA_PASS=your_taiga_password
TAIGA_PROJECT_SLUG=your_taiga_project_slug

# ── Google Gemini LLM Models ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
AGENT_MODEL=gemini-3.5-flash
CLASSIFIER_MODEL=gemini-2.5-flash

# ── Root Backend Identity Resolution & Entitlement Guard ─────────────────────
BACKEND_URL=http://localhost:8000
SERVICE_API_KEY=svc_your_shared_internal_service_key
INTEGRATION_TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here=
STRICT_IDENTITY_ENFORCEMENT=true
IDENTITY_CACHE_TTL_SECONDS=30

# ── Storage & Memory Stores ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=agent_bridge

# ── Semantic Embeddings & Context Budgeting ───────────────────────────────────
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=3072
MEMORY_CHUNK_TOKENS=400
MEMORY_CHUNK_OVERLAP=60
MEMORY_TOP_K=5
MEMORY_MAX_TOKENS=2000
MAX_ITERATIONS=8
CONTEXT_CACHE_TTL=60
MEMORY_API_KEY=change_me_in_production

# ── Kafka Event Bridge ────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9093
VOICE_TO_TEXT_CHANNEL_MAP=voice_channel_id:text_channel_id

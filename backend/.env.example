# ── Litestar Root Backend Environment Example ──────────────────────────────────
APP_NAME="CoordinaAI API"
DEBUG=true
HOST=0.0.0.0
PORT=8000
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/coordinaai

# ── Service-to-Service Authentication Key (Shared with agent-bridge & voice bot) ─
SERVICE_API_KEY=svc_your_shared_internal_service_key

# ── JWT Authentication & Tokens ───────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
OTP_SECRET_KEY=change-this-in-production
INVITATION_TOKEN_EXPIRY_DAYS=7

# ── Integration Token Encryption (Fernet 32-byte Base64 key) ───────────────────
INTEGRATION_TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here=
INTEGRATION_TOKEN_REFRESH_ENABLED=true
INTEGRATION_TOKEN_REFRESH_INTERVAL_MINUTES=60

# ── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
IDENTITY_CACHE_TTL_SECONDS=60

# ── OAuth Provider Credentials ────────────────────────────────────────────────
GITHUB_OAUTH_CLIENT_ID=your_github_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
DISCORD_OAUTH_CLIENT_ID=your_discord_client_id
DISCORD_OAUTH_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token

# ── Stripe Billing & Subscriptions ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...

# ── Email / SMTP Configuration ────────────────────────────────────────────────
FROM_EMAIL=noreply@example.com
FROM_NAME="CoordinaAI"
SUPPORT_EMAIL=support@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_SCHEDULER_ENABLED=true

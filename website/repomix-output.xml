<style>
/* ==================== CUSTOM CSS (cannot be expressed in Tailwind) ==================== */
@keyframes meshFloat {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25% { transform: translate(2%, -1%) scale(1.02); }
  50% { transform: translate(-1%, 2%) scale(0.98); }
  75% { transform: translate(-2%, -1%) scale(1.01); }
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}
@keyframes orbFloat1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(-30px, 40px) scale(1.1); }
}
@keyframes orbFloat2 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(40px, -30px) scale(0.9); }
}
@keyframes successIn {
  from { opacity: 0; transform: scale(0.95) translateY(20px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
@keyframes ringPulse {
  0%, 100% { transform: scale(1); opacity: 0.3; }
  50% { transform: scale(1.1); opacity: 0.1; }
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Mesh background - complex gradients, noise, animations */
.mesh-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
.mesh-bg::before {
  content: ''; position: absolute;
  width: 140%; height: 140%; top: -20%; left: -20%;
  background:
    radial-gradient(ellipse 60% 50% at 20% 40%, rgba(99, 102, 241, 0.08) 0%, transparent 70%),
    radial-gradient(ellipse 50% 60% at 80% 20%, rgba(139, 92, 246, 0.06) 0%, transparent 70%),
    radial-gradient(ellipse 70% 40% at 60% 80%, rgba(59, 130, 246, 0.05) 0%, transparent 70%);
  animation: meshFloat 20s ease-in-out infinite;
}
.mesh-bg::after {
  content: ''; position: absolute; inset: 0;
  background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  opacity: 0.025; mix-blend-mode: overlay;
}

/* Floating orbs */
.orb { position: fixed; border-radius: 50%; filter: blur(80px); pointer-events: none; z-index: 0; opacity: 0.4; }
.orb-1 {
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.3), transparent 70%);
  top: -100px; right: -100px;
  animation: orbFloat1 15s ease-in-out infinite;
}
.orb-2 {
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.2), transparent 70%);
  bottom: 10%; left: 5%;
  animation: orbFloat2 18s ease-in-out infinite;
}

/* Particle canvas */
#particleCanvas { position: fixed; inset: 0; z-index: 1; pointer-events: none; }

/* Visual panel gradient overlay */
.visual-panel::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 0%, rgba(10,10,12,0.3) 50%, rgba(10,10,12,0.85) 100%);
  z-index: 1;
}

/* Step connector fill animation */
.step-connector { flex: 1; height: 1px; background: rgba(255,255,255,0.06); position: relative; overflow: hidden; }
.step-connector::after {
  content: ''; position: absolute; inset: 0;
  background: #6366f1;
  transform: translateX(-100%);
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.step-connector.filled::after { transform: translateX(0); }

/* Logo mark inner cutout */
.logo-mark::after {
  content: ''; position: absolute; inset: 1px;
  border-radius: calc(8px - 1px);
  background: #0a0a0c;
}

/* Success ring outer glow */
.success-ring::before {
  content: ''; position: absolute; inset: -4px; border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, transparent);
  opacity: 0.3;
  animation: ringPulse 2s ease-in-out infinite;
}

/* Divider lines */
.divider::before, .divider::after {
  content: ''; flex: 1; height: 1px;
  background: rgba(255,255,255,0.06);
}

/* Submit button overlay */
.submit-btn { position: relative; overflow: hidden; }
.submit-btn::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
  opacity: 0; transition: opacity 0.3s ease;
  pointer-events: none;
}
.submit-btn:hover::before { opacity: 1; }

/* JS-managed state transitions */
.step-content { display: none; }
.step-content.active { display: block; }
.step-content.visible { opacity: 1 !important; transform: translateY(0) !important; }
.success-state { display: none; }
.success-state.active { display: block; animation: successIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
.error-message { opacity: 0; transform: translateY(-4px); transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
.error-message.show { opacity: 1; transform: translateY(0); }
.form-input.error { border-color: #ef4444 !important; box-shadow: 0 0 0 3px rgba(239,68,68,0.1) !important; }

/* Step states */
.step { transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
.step.active { color: #f5f5f7; }
.step.completed { color: #6366f1; }
.step-number { transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
.step.active .step-number { border-color: #6366f1; background: rgba(99,102,241,0.1); color: #6366f1; }
.step.completed .step-number { border-color: #6366f1; background: #6366f1; color: #fff; }

/* Button loading state */
.submit-btn.loading .btn-loader { display: block; }
.submit-btn.loading .btn-text { display: none; }

/* Password strength bar colors */
.strength-bar.weak { background: #ef4444; }
.strength-bar.fair { background: #f59e0b; }
.strength-bar.good { background: #3b82f6; }
.strength-bar.strong { background: #22c55e; }

/* Focus sibling icon */
.form-input:focus + .input-icon { color: #6366f1; }

/* Custom checkbox */
.checkbox-input {
  appearance: none; width: 20px; height: 20px; min-width: 20px;
  border: 1.5px solid rgba(255,255,255,0.06);
  border-radius: 6px; background: #1a1a1f; cursor: pointer;
  position: relative; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); margin-top: 1px;
}
.checkbox-input:checked { background: #6366f1; border-color: #6366f1; }
.checkbox-input:checked::after {
  content: ''; position: absolute; left: 6px; top: 2px;
  width: 5px; height: 10px;
  border: solid white; border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}
</style>
</head>

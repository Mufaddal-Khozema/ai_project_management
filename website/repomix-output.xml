  <script>
    // ===== PARTICLE SYSTEM =====
    const canvas = document.getElementById('particleCanvas');
    const ctx = canvas.getContext('2d');
    let particles = [];
    let mouseX = 0;
    let mouseY = 0;
    let isTouch = window.matchMedia('(pointer: coarse)').matches;

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    class Particle {
      constructor() {
        this.reset();
      }

      reset() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.size = Math.random() * 1.5 + 0.5;
        this.speedX = (Math.random() - 0.5) * 0.3;
        this.speedY = (Math.random() - 0.5) * 0.3;
        this.opacity = Math.random() * 0.5 + 0.1;
        this.life = Math.random() * 200 + 100;
        this.age = 0;
      }

      update() {
        this.x += this.speedX;
        this.y += this.speedY;
        this.age++;

        if (!isTouch) {
          const dx = this.x - mouseX;
          const dy = this.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 120) {
            const force = (120 - dist) / 120;
            this.x += (dx / dist) * force * 1.5;
            this.y += (dy / dist) * force * 1.5;
          }
        }

        if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height || this.age > this.life) {
          this.reset();
        }
      }

      draw() {
        const fade = 1 - (this.age / this.life);
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(160, 160, 180, ${this.opacity * fade})`;
        ctx.fill();
      }
    }

    const particleCount = isTouch ? 30 : 60;
    for (let i = 0; i < particleCount; i++) {
      particles.push(new Particle());
    }

    function drawConnections() {
      const maxDist = 120;
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < maxDist) {
            const opacity = (1 - dist / maxDist) * 0.08;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(140, 140, 180, ${opacity})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }
    }

    let frameCount = 0;
    function animate() {
      frameCount++;
      if (isTouch && frameCount % 2 !== 0) {
        requestAnimationFrame(animate);
        return;
      }

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      particles.forEach(p => {
        p.update();
        p.draw();
      });

      drawConnections();
      requestAnimationFrame(animate);
    }
    animate();

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    // ===== FORM LOGIC =====
    const form = document.getElementById('signupForm');
    const step1Next = document.getElementById('step1Next');
    const backBtn = document.getElementById('backBtn');
    const submitBtn = document.getElementById('submitBtn');
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirmPassword');
    const strengthMeter = document.getElementById('strengthMeter');
    const strengthLabel = document.getElementById('strengthLabel');
    const eyeIcon = document.getElementById('eyeIcon');

    let currentStep = 1;
    let passwordVisible = false;

    function goToStep(step) {
      const contents = document.querySelectorAll('.step-content');
      const steps = document.querySelectorAll('.step');
      const connectors = document.querySelectorAll('.step-connector');

      contents.forEach(c => {
        c.classList.remove('active', 'visible');
      });

      steps.forEach((s, i) => {
        s.classList.remove('active', 'completed');
        if (i + 1 < step) {
          s.classList.add('completed');
        } else if (i + 1 === step) {
          s.classList.add('active');
        }
      });

      connectors.forEach((c, i) => {
        c.classList.toggle('filled', i + 1 < step);
      });

      const target = document.querySelector(`[data-step-content="${step}"]`);
      if (target) {
        target.classList.add('active');
        setTimeout(() => target.classList.add('visible'), 50);
      }

      currentStep = step;
    }

    step1Next.addEventListener('click', () => {
      const fullName = document.getElementById('fullName');
      const email = document.getElementById('email');
      const company = document.getElementById('company');
      let valid = true;

      if (!fullName.value.trim() || fullName.value.trim().length < 2) {
        showError('fullName', true);
        valid = false;
      } else {
        showError('fullName', false);
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email.value.trim())) {
        showError('email', true);
        valid = false;
      } else {
        showError('email', false);
      }

      if (!company.value.trim()) {
        showError('company', true);
        valid = false;
      } else {
        showError('company', false);
      }

      if (valid) {
        step1Next.classList.add('loading');
        setTimeout(() => {
          step1Next.classList.remove('loading');
          goToStep(2);
        }, 600);
      }
    });

    backBtn.addEventListener('click', () => {
      goToStep(1);
    });

    togglePassword.addEventListener('click', () => {
      passwordVisible = !passwordVisible;
      passwordInput.type = passwordVisible ? 'text' : 'password';
      confirmInput.type = passwordVisible ? 'text' : 'password';
      eyeIcon.innerHTML = passwordVisible
        ? '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/><line x1="4.22" y1="4.22" x2="19.78" y2="19.78"/>'
        : '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>';
    });

    passwordInput.addEventListener('input', () => {
      const val = passwordInput.value;
      const bars = strengthMeter.querySelectorAll('.strength-bar');

      bars.forEach(b => b.className = 'strength-bar');

      let strength = 0;
      if (val.length >= 8) strength++;
      if (val.length >= 12) strength++;
      if (/[A-Z]/.test(val)) strength++;
      if (/[0-9]/.test(val)) strength++;
      if (/[^A-Za-z0-9]/.test(val)) strength++;

      const classes = ['weak', 'fair', 'good', 'strong'];
      const labels = ['Too weak', 'Could be stronger', 'Solid', 'Fortress-level'];
      const activeBars = Math.min(Math.ceil(strength / 1.5), 4);

      for (let i = 0; i < activeBars; i++) {
        bars[i].classList.add(classes[Math.min(activeBars - 1, 3)]);
      }

      strengthLabel.textContent = val.length > 0 ? labels[Math.min(activeBars - 1, 3)] : '';
      showError('password', false);
    });

    ['fullName', 'email', 'company'].forEach(id => {
      document.getElementById(id).addEventListener('input', () => showError(id, false));
    });

    confirmInput.addEventListener('input', () => showError('confirmPassword', false));

    function showError(fieldId, show) {
      const input = document.getElementById(fieldId);
      const error = document.getElementById(fieldId + 'Error');
      if (input) input.classList.toggle('error', show);
      if (error) error.classList.toggle('show', show);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const password = passwordInput.value;
      const confirm = confirmInput.value;
      const terms = document.getElementById('termsCheck');
      let valid = true;

      if (password.length < 8) {
        showError('password', true);
        valid = false;
      }

      if (password !== confirm || !confirm) {
        showError('confirmPassword', true);
        valid = false;
      }

      if (!terms.checked) {
        terms.parentElement.style.animation = 'shake 0.4s ease';
        setTimeout(() => terms.parentElement.style.animation = '', 400);
        valid = false;
      }

      if (valid) {
        submitBtn.classList.add('loading');
        submitBtn.disabled = true;

        setTimeout(() => {
          submitBtn.classList.remove('loading');
          document.querySelectorAll('.step-content').forEach(c => c.style.display = 'none');
          document.querySelector('.progress-track').style.display = 'none';
          document.querySelector('.divider').style.display = 'none';
          document.querySelector('.social-grid').style.display = 'none';
          document.querySelector('.form-footer').style.display = 'none';
          document.getElementById('successState').classList.add('active');
        }, 2000);
      }
    });

    // Input focus effects
    document.querySelectorAll('.form-input').forEach(input => {
      input.addEventListener('focus', () => {
        input.parentElement.style.transform = 'scale(1.01)';
      });
      input.addEventListener('blur', () => {
        input.parentElement.style.transform = 'scale(1)';
      });
    });
  </script>


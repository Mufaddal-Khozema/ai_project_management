  "components": {
    "schemas": {
      "PlanResponse": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price_monthly": {
            "type": "integer"
          },
          "price_yearly": {
            "type": "integer"
          },
          "price_id_monthly": {
            "type": "string"
          },
          "price_id_yearly": {
            "type": "string"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "badge": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "highlighted": {
            "type": "boolean",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "description",
          "features",
          "id",
          "name",
          "price_id_monthly",
          "price_id_yearly",
          "price_monthly",
          "price_yearly"
        ],
        "title": "PlanResponse"
      },
      "PlansResponse": {
        "properties": {
          "plans": {
            "items": {
              "$ref": "#/components/schemas/PlanResponse"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "plans"
        ],
        "title": "PlansResponse"
      },
      "SendOTPRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "SendOTPRequest"
      },
      "SendOTPResponse": {
        "properties": {
          "message": {
            "type": "string"
          },
          "expires_in_seconds": {
            "type": "integer"
          }
        },
        "type": "object",
        "required": [
          "expires_in_seconds",
          "message"
        ],
        "title": "SendOTPResponse"
      },
      "SetupIntentRequest": {
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "price_id": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "email",
          "name",
          "price_id"
        ],
        "title": "SetupIntentRequest"
      },
      "SetupIntentResponse": {
        "properties": {
          "client_secret": {
            "type": "string"
          },
          "setup_intent_id": {
            "type": "string"
          },
          "customer_id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "client_secret",
          "setup_intent_id"
        ],
        "title": "SetupIntentResponse"
      },
      "SocialAuthRequest": {
        "properties": {
          "code": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "code",
          "redirect_uri"
        ],
        "title": "SocialAuthRequest"
      },
      "VerifyOTPRequest": {
        "properties": {

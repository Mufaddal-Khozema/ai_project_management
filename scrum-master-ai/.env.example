# ── Scrum Master Voice Bot Environment Example ────────────────────────────────
PORT=3001
HOST=0.0.0.0
ENVIRONMENT=development

# ── Gemini Live Voice API ─────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-live-preview

# ── Discord Voice Bot ─────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
VOICE_TO_TEXT_CHANNEL_MAP=voice_channel_id:text_channel_id

# ── MongoDB Storage (Meetings & Scheduling) ───────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/scrum-master-ai
INTEGRATIONS_STORAGE_DRIVER=mongo
INTEGRATIONS_DATA_DIR=./data
INTEGRATIONS_ENCRYPTION_KEY=your_fernet_or_aes_encryption_key
OAUTH_STATE_SECRET=your_oauth_state_random_secret
INTEGRATIONS_BASE_URL=http://localhost:3001/integrations

# ── Root Backend Identity & Authorization (Litestar on port 8000) ─────────────
BACKEND_URL=http://localhost:8000
SERVICE_API_KEY=svc_your_shared_internal_service_key
INTEGRATION_TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here=
DEFAULT_ORG_ID=default

# ── Taiga Integration ─────────────────────────────────────────────────────────
TAIGA_URL=https://api.taiga.io/api/v1
TAIGA_USER=your_taiga_user
TAIGA_PASS=your_taiga_pass
TAIGA_PROJECT_SLUG=your_taiga_project_slug

# ── Kafka Event Streaming ─────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9093
KAFKA_CLIENT_ID=scrum-master-ai

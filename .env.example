# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://auth_user:auth_pass@localhost:5432/auth_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_USER_CREATED=auth.user.created
KAFKA_TOPIC_LOGIN_SUCCESS=auth.user.login.success
KAFKA_TOPIC_LOGIN_FAILED=auth.user.login.failed
KAFKA_TOPIC_TOKEN_REFRESHED=auth.token.refreshed

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MONTHLY=price_monthly_xxxxxxxxx
STRIPE_PRICE_YEARLY=price_yearly_xxxxxxxxx

# ─── App URLs (used for OAuth redirects) ─────────────────────────────────────
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ─── Integrations: token encryption ──────────────────────────────────────────
# Fernet key used to encrypt/decrypt integration access tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_TOKEN_REFRESH_INTERVAL_MINUTES=60
INTEGRATION_TOKEN_REFRESH_LEAD_MINUTES=2880
INTEGRATION_TOKEN_REFRESH_ENABLED=true

# ─── Integrations: OAuth app credentials ─────────────────────────────────────
# Register an OAuth app with each provider, set the redirect URI to
#   {APP_URL}/api/integrations/oauth/{provider}/callback
# and fill in the matching client ID/secret. See README "Integrations" section.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Bot token for the Discord application (enables listing guild members during
# onboarding). Optional — without it the app falls back to the user token.
DISCORD_BOT_TOKEN=
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=
# Taiga has no OAuth2 server; connections use the user's Taiga credentials
# against {TAIGA_BASE_URL}/api/v1/auth/token. Cloud default is tree.taiga.io.
TAIGA_BASE_URL=https://tree.taiga.io

# ─── Default Roles ────────────────────────────────────────────────────────────
DEFAULT_ROLE=user
